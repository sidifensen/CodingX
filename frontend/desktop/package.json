{
  "name": "desktop",
  "version": "0.1.0",
  "private": true,
  "description": "CodingX Electron desktop host",
  "author": "CodingX",
  "main": "dist/main.js",
  "scripts": {
    "prestart": "npm run build",
    "build": "tsc -p tsconfig.json",
    "start": "electron .",
    "dev": "npm run start",
    "dev:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/dev-all.ps1",
    "build:user": "npm --prefix ../user run build",
    "pack:win": "npm run build && npm run build:user && electron-builder --win nsis",
    "pack:dir": "npm run build && npm run build:user && electron-builder --dir"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^22.14.0",
    "electron": "^31.0.2",
    "electron-builder": "^24.13.3",
    "typescript": "~5.8.2"
  },
  "build": {
    "appId": "com.codingx.desktop",
    "productName": "CodingX",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../user/dist",
        "to": "user-dist"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    }
  }
}
